FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1


RUN rm -rf /var/lib/apt/lists/* && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-dev \
        python3-pip \
        python3.11-distutils \
        libglib2.0-0 \
        libgomp1 \
        libxcb1 \
        ffmpeg \
        curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*


RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11

WORKDIR /app


COPY requirements.txt .


RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        torch==2.4.1 torchvision==0.19.1 \
        --index-url https://download.pytorch.org/whl/cu124 && \
    grep -vE "^(torch|torchvision|opencv-python|onnxsim)" requirements.txt | \
        grep -v "^#" | grep -v "^$" | \
        pip install --no-cache-dir -r /dev/stdin && \
    pip uninstall -y opencv-python 2>/dev/null || true && \
    pip install --no-cache-dir "opencv-python-headless>=4.8.0"


COPY . .

RUN mkdir -p uploads outputs static/snapshots database models runs


ENV HOST=0.0.0.0 \
    PORT=5001 \
    DEBUG=False \
    INFERENCE_DEVICE=cuda:0 \
    POTHOLE_MODEL_PATH=/app/models/pothole_yolov8.pt \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

EXPOSE 5001


HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:${PORT:-5001}/api/health || exit 1

CMD ["python", "app.py"]
